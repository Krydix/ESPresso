{
  NAME "Print-Job preserves a URF document"
  OPERATION Print-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name espresso-compat
  ATTR mimeMediaType document-format image/urf
  FILE tests/minimal.urf
  STATUS successful-ok
  EXPECT job-id OF-TYPE integer WITH-VALUE >0
}
{
  NAME "Validate-Job relays"
  OPERATION Validate-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR mimeMediaType document-format image/urf
  STATUS successful-ok
}
{
  NAME "Create-Job relays"
  OPERATION Create-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name espresso-compat
  ATTR mimeMediaType document-format image/urf
  STATUS successful-ok
  EXPECT job-id OF-TYPE integer WITH-VALUE >0
}
{
  NAME "Send-Document preserves a URF document"
  OPERATION Send-Document
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $job-id
  ATTR boolean last-document true
  ATTR mimeMediaType document-format image/urf
  FILE tests/minimal.urf
  STATUS successful-ok
}
{
  NAME "Get-Job-Attributes relays"
  OPERATION Get-Job-Attributes
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $job-id
  STATUS successful-ok
  EXPECT job-id OF-TYPE integer WITH-VALUE $job-id
}
{
  NAME "Get-Jobs relays"
  OPERATION Get-Jobs
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  STATUS successful-ok
}
{
  NAME "Cancel-Job relays the completed-job error"
  OPERATION Cancel-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $job-id
  STATUS client-error-not-possible
}
{
  NAME "Unsafe Print-URI is rejected locally"
  OPERATION Print-URI
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR uri document-uri https://example.invalid/document.pdf
  STATUS server-error-operation-not-supported
}
